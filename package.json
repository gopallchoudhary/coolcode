{
	"name": "coolcode",
	"version": "1.0.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:cli": "bun run --watch packages/cli/src/index.tsx",
		"dev:server": "bun run --hot packages/server/src/index.ts",
		"dev:web": "bun run --filter @coolcode/web dev",
		"build:cli": "bun run --filter @coolcode/cli build",
		"build:web": "bun run --filter @coolcode/web build",
		"link:cli": "bun run build:cli && cd packages/cli && bun link"
	},
	"dependencies": {
		"dotenv": "^17.4.2"
	}
}
